    },
    "Switch sides.": {
      "file": "39d55cbaabf21a0a.mp3",
      "duration": 1.73
    },
    "Take it to the floor. Find a spot to get down on the ground, or stay standing if you prefer.": {
      "file": "af9938c51a5afae3.mp3",
      "duration": 6.35
    },
    "Two to go. Quick feet now. Light and bouncy.": {
      "file": "bc678f2c4d2c40ab.mp3",
