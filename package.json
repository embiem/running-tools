{
  "name": "running-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --output-structure locale-modules --strategy localStorage preferredLanguage baseLocale --silent",
    "check": "npm run i18n && node scripts/check-messages.mjs && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "narrate": "npm run i18n && node scripts/generate-narration.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.6.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "kokoro-js": "^1.2.1",
    "svelte": "^5.39.9",
    "svelte-check": "^4.3.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.1.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "sharp": "^0.33.5",
    "sharp-ico": "^0.1.5"
  }
}
