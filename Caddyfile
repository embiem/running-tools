{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	root * {{.DIST_DIR}}

	# Vite fingerprints everything under /assets with a content hash, so it is
	# safe (and required, to avoid MIME-type errors from a stale index.html
	# requesting a hash that no longer exists on disk) to cache it forever.
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, manifest.webmanifest, sw.js, icons) is
	# unhashed and must always be revalidated so a reload after a deploy picks
	# up the asset hashes the new index.html actually references.
	@unhashed {
		not path /assets/*
	}
	header @unhashed Cache-Control "no-cache"

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# This app is hash-routed (see src/App.svelte) — there are no server-side
	# paths to fall back for, so unmatched requests (e.g. a deleted hashed
	# asset from a previous deploy) correctly 404 instead of masquerading as
	# index.html with the wrong MIME type.
	try_files {path} {path}.html {path}/index.html
}
