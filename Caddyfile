{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	root * {{.DIST_DIR}}

	# Vite fingerprints everything under /assets with a content hash, so a given
	# URL's bytes never change and it can be cached forever. The `file` gate
	# keeps that year-long TTL off 404s for hashes a later deploy removed.
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, manifest.webmanifest, sw.js, icons) is
	# unhashed and must always be revalidated so a reload after a deploy picks
	# up the asset hashes the new index.html actually references.
	@unhashed {
		not path /assets/*
	}
	header @unhashed Cache-Control "no-cache"

	# Caddy has no MIME mapping for .webmanifest, so file_server would leave the
	# type to content sniffing (text/plain in the deploy image).
	header /manifest.webmanifest Content-Type "application/manifest+json"

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# This app is hash-routed (see src/App.svelte) — there are no server-side
	# paths to fall back for, so unmatched requests (e.g. a deleted hashed
	# asset from a previous deploy) correctly 404 instead of masquerading as
	# index.html with the wrong MIME type.
	try_files {path} {path}.html {path}/index.html
}
